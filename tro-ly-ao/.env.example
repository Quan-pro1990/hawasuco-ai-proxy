# ============================================================
#  CẤU HÌNH TRỢ LÝ ẢO GIỌNG NÓI
#  Chép file này thành ".env" (CaiDat.bat tự làm), rồi điền các dòng bên dưới.
#  File .env chứa khoá bí mật: KHÔNG gửi cho ai, KHÔNG đưa lên GitHub (đã chặn sẵn trong .gitignore).
#  Dòng bắt đầu bằng # là ghi chú.
# ============================================================

# --- 1. Khoá API Anthropic (bắt buộc) ---
# Lấy tại https://console.anthropic.com → API Keys. Tiền dùng tính vào tài khoản đó.
ANTHROPIC_API_KEY=

# --- 2. Nối với máy chủ "Quản lý thất thoát nước" (IIS) ---
# Có dòng này thì: người dùng đăng nhập trợ lý bằng chính tài khoản phần mềm thất thoát nước,
# và trợ lý tra được số liệu thất thoát / đồng hồ cấp 1 đúng quyền của tài khoản đó.
# Địa chỉ giống lúc "Kết nối máy chủ…" trong phần mềm, vd: localhost:8080   hoặc   tenmien.vn:8080/thatthoat
MAYCHU_DIACHI=
# Mã nhận dạng chứng chỉ do CaiDat-IIS.bat in ra (vd ABCD-EF01-2345-6789). Bỏ trống nếu máy chủ dùng chứng chỉ thật.
MAYCHU_MANHANDANG=

# --- 3. Khi KHÔNG nối máy chủ thất thoát nước: mật khẩu chung để vào trợ lý ---
# Bỏ trống cả MAYCHU_DIACHI và dòng này thì trợ lý chỉ mở được ngay trên máy đang chạy nó.
TRO_LY_MAT_KHAU=

# --- 4. HTTPS (cần để dùng micro trên điện thoại / máy khác) ---
# Chạy TaoChungChi.bat sẽ tự tạo chứng chỉ và điền 2 dòng này.
HTTPS_PFX=
HTTPS_PFX_MATKHAU=
# Hoặc dùng cặp file PEM:
# HTTPS_CERT=chungchi.crt
# HTTPS_KEY=chungchi.key

# --- 5. Tuỳ chọn ---
# Cổng mở trang trợ lý (mặc định 8090): https://<máy chủ>:8090/
CONG=8090
# Tên công ty để trợ lý xưng (bỏ trống = lấy từ máy chủ thất thoát nước)
TEN_CONG_TY=
# Mô hình Claude và mức suy nghĩ (low = trả lời nhanh nhất, hợp với nói chuyện; medium / high = kỹ hơn nhưng chậm hơn)
TRO_LY_MODEL=claude-opus-5-5
TRO_LY_EFFORT=low
# 1 = cho trợ lý tìm kiếm web (tin tức, thời tiết…). Tốn thêm phí mỗi lần tìm.
TIM_KIEM_WEB=0
# Số câu hỏi tối đa mỗi người trong 1 giờ (chống dùng quá tay)
GIOI_HAN_MOI_GIO=120
# 0 = tắt "mô hình dự phòng" (khi Claude Opus từ chối 1 câu vì bộ lọc an toàn, API tự trả lời bằng mô hình khác)
TRO_LY_DU_PHONG=1
