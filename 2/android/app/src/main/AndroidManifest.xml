<?xml version="1.0" encoding="utf-8"?>
<!-- App Android "Thất thoát nước": mở website trên máy chủ IIS (HTTP cổng 80) trong WebView, tải / in / chia sẻ báo cáo. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: website chạy HTTP (không mã hoá) cổng 80 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThatThoat"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- đưa file Excel / PDF vừa tải cho ứng dụng khác mở, chia sẻ -->
        <provider
            android:name=".TepProvider"
            android:authorities="vn.com.hawasuco.thatthoat.tep"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
