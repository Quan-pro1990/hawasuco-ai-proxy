<?xml version="1.0" encoding="utf-8"?>
<!--
  Website IIS của phần mềm Quản lý thất thoát nước (HTTP cổng 80): trang web cho trình duyệt máy tính / điện thoại,
  app Android và máy chủ dữ liệu cho phần mềm trên máy tính.
  ASP.NET Core Module V2 (có sẵn trong ASP.NET Core Hosting Bundle, vd 9.0) chạy ThatThoatNuoc.exe ở chế độ out-of-process
  và chuyển mọi yêu cầu tới nó. App pool: No Managed Code. Dữ liệu nằm ở thư mục THATTHOAT_DULIEU (ngoài thư mục web).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAV (nếu máy chủ có) chặn PUT / DELETE: bỏ cho site này -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <!-- cài làm ứng dụng con dưới site ASP.NET Core khác: bỏ handler thừa kế từ site cha -->
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\ThatThoatNuoc.exe" arguments="" hostingModel="outofprocess"
                  requestTimeout="00:05:00" startupTimeLimit="60" shutdownTimeLimit="10"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="THATTHOAT_DULIEU" value="C:\ThatThoatNuocData" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- dữ liệu máy tính gửi lên tới 48 MB -->
          <requestLimits maxAllowedContentLength="50331648" />
          <verbs allowUnlisted="true" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
