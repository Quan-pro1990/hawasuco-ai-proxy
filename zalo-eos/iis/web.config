<?xml version="1.0" encoding="utf-8"?>
<!--
  Site IIS cho máy chủ trung gian Zalo OA - EOS (chép file này vào thư mục gốc của site, cạnh package.json).
  ASP.NET Core Module V2 (có sẵn trong ASP.NET Core Hosting Bundle, máy chủ IIS đã cài cho phần mềm Thất thoát nước)
  chạy node.exe ở chế độ out-of-process, tự đặt biến ASPNETCORE_PORT và chuyển mọi yêu cầu tới node.
  App pool: No Managed Code. Mọi yêu cầu đều qua node nên IIS không phục vụ thẳng file nào (kể cả .env).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Node cài chỗ khác thì sửa processPath (xem bằng lệnh: where node) -->
      <aspNetCore processPath="C:\Program Files\nodejs\node.exe" arguments=".\src\server.js" hostingModel="outofprocess"
                  requestTimeout="00:02:00" startupTimeLimit="60" shutdownTimeLimit="10"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <!-- token Zalo + liên kết khách hàng: để ngoài thư mục web, chỉ app pool được ghi -->
          <environmentVariable name="THU_MUC_DU_LIEU" value="C:\ZaloEosData" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
