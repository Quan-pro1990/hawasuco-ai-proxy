# ============================================================
#  Cấu hình máy chủ trung gian Zalo OA <-> EOS
#  Chép file này thành .env rồi điền. KHÔNG đưa file .env lên GitHub.
# ============================================================

# ---------- Chung ----------
# Địa chỉ công khai của máy chủ này (HTTPS, chứng chỉ thật), không có / ở cuối
URL_CONG_KHAI=https://zalo.tencongty.vn
# Chuỗi bí mật để mở trang cấp quyền /zalo/cap-quyen và /trang-thai (tự đặt, dài và khó đoán)
KHOA_QUAN_TRI=
# Nơi lưu token Zalo và danh sách liên kết khách hàng. Mặc định: thư mục du-lieu cạnh package.json.
# Chạy qua IIS thì iis\web.config đã đặt C:\ZaloEosData (ngoài thư mục web), không cần khai ở đây.
# THU_MUC_DU_LIEU=C:\ZaloEosData
TEN_CONG_TY=Công ty Cổ phần Cấp thoát nước ...
SDT_CSKH=
# Số kỳ hiện trong lịch sử sử dụng / danh sách hoá đơn
SO_KY_LICH_SU=6
# Cổng khi chạy riêng bằng "npm start" (chạy qua IIS thì IIS tự chọn cổng)
PORT=3000

# ---------- Zalo (developers.zalo.me) ----------
# Ứng dụng của bạn > Thông tin ứng dụng: ID ứng dụng và Khoá bí mật
ZALO_APP_ID=
ZALO_SECRET_KEY=
# Ứng dụng > Webhook: "OA Secret Key" (dùng kiểm chữ ký sự kiện)
ZALO_OA_SECRET_KEY=
# 1 = kiểm chữ ký webhook (bắt buộc khi chạy thật). 0 chỉ dùng lúc thử nghiệm.
ZALO_KIEM_CHU_KY=1

# ---------- EOS ----------
# mau = dữ liệu mẫu để chạy thử; api = gọi API của phần mềm EOS
EOS_CHE_DO=mau
# Địa chỉ gốc API EOS do nhà cung cấp EOS cấp, vd https://eos.tencongty.vn hoặc http://10.0.0.5:8080
EOS_URL=
# Cách xác thực với EOS:
#   khong    : không cần
#   bearer   : header "Authorization: Bearer <EOS_KHOA>"
#   header   : header "<EOS_TEN_HEADER>: <EOS_KHOA>"  (vd X-API-Key)
#   basic    : tài khoản / mật khẩu kiểu Basic
#   dangnhap : gọi EOS_DUONG_DANG_NHAP bằng tài khoản / mật khẩu để lấy token, tự đăng nhập lại khi hết hạn
EOS_XAC_THUC=bearer
EOS_KHOA=
EOS_TEN_HEADER=X-API-Key
EOS_TAI_KHOAN=
EOS_MAT_KHAU=
EOS_TRUONG_TAI_KHOAN=username
EOS_TRUONG_MAT_KHAU=password
EOS_PHUT_TOKEN=50
# Chờ EOS trả lời tối đa (mili giây)
EOS_THOI_GIAN_CHO=15000

# Đường dẫn API EOS (theo tài liệu API EOS). Mặc định là GET; viết "POST /duong-dan" để gửi tham số dạng JSON.
# Tham số dùng được: {maKH} {soKy} {soHD} {ky} {thang} {nam} {maTraCuu}. Ghi "khong" để bỏ 1 bước.
EOS_DUONG_DANG_NHAP=POST /api/auth/login
EOS_DUONG_KHACH_HANG=/api/khachhang/{maKH}
EOS_DUONG_LICH_SU=/api/khachhang/{maKH}/tieuthu?soKy={soKy}
EOS_DUONG_HOA_DON=/api/khachhang/{maKH}/hoadon?soKy={soKy}
EOS_DUONG_TAI_HOA_DON=/api/hoadon/{soHD}/pdf
