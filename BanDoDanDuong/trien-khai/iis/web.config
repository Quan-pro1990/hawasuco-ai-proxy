<?xml version="1.0" encoding="utf-8"?>
<!--
  HawaMap trên IIS — cách 1 (khuyên dùng): IIS tự chạy và giám sát máy chủ Node (server.js) qua HttpPlatformHandler.
  Thư mục gốc của site = thư mục ứng dụng (server.js, kho-giao-thong.js, package.json, public\).
  Cần cài: Node.js 18+ (bản Windows x64, cho mọi người dùng), HttpPlatformHandler 1.2, URL Rewrite 2.1.

  Script trien-khai\iis\cai-dat-iis.ps1 tự điền các giá trị __...__ bên dưới. Sửa tay thì thay:
    __NODE__       đường dẫn node.exe, vd. C:\Program Files\nodejs\node.exe
    __THU_MUC__    thư mục ứng dụng, vd. C:\inetpub\hawamap
    __DU_LIEU__    thư mục dữ liệu (báo cáo, dữ liệu giao thông), vd. C:\HawaMapData — tài khoản "IIS AppPool\HawaMap" cần quyền sửa
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- mọi yêu cầu chuyển cho Node: IIS không tự phục vụ tệp nào trong thư mục (server.js, dữ liệu… không bị tải về) -->
      <add name="HawaMapNode" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="__NODE__" arguments="&quot;__THU_MUC__\server.js&quot;"
                  startupTimeLimit="60" startupRetryCount="3" requestTimeout="00:03:00"
                  stdoutLogEnabled="true" stdoutLogFile="__THU_MUC__\logs\node" processesPerApplication="1">
      <environmentVariables>
        <!-- HttpPlatformHandler chọn cổng nội bộ và chuyển yêu cầu tới đó -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="BANDO_DULIEU" value="__DU_LIEU__" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
    <rewrite>
      <rules>
        <!-- GPS, micro, camera trên điện thoại chỉ chạy qua HTTPS: script cài đặt bật (enabled="true") khi site đã có binding HTTPS -->
        <rule name="HawaMap-HTTPS" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <add input="{HTTP_HOST}" pattern="^(localhost|127\.0\.0\.1)(:\d+)?$" negate="true" />
            <!-- để Let's Encrypt (win-acme) xác minh tên miền qua http khi xin / gia hạn chứng chỉ -->
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- ghi IP thật của người dùng cho Node (giới hạn số báo cáo theo IP); server.js chỉ tin header này từ 127.0.0.1 -->
        <rule name="HawaMap-IP">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="None" />
        </rule>
      </rules>
    </rewrite>
    <!-- Node đã nén gzip; tắt nén của IIS để không nén hai lần -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- yêu cầu gửi báo cáo rất nhỏ -->
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
