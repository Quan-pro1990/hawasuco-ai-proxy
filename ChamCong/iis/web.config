<?xml version="1.0" encoding="utf-8"?>
<!--
  Site IIS của phần mềm "Nhân sự – Chấm công – Tiền lương" (máy chủ dữ liệu dùng chung).
  ASP.NET Core Module V2 (trong ASP.NET Core Hosting Bundle) chạy ChamCongMayChu.exe ở chế độ out-of-process
  và chuyển mọi yêu cầu tới nó. App pool: No Managed Code. Dữ liệu nằm ở CHAMCONG_DULIEU (ngoài thư mục web),
  bản sao lưu hằng ngày ở CHAMCONG_SAOLUU. Bộ cài CaiDat-IIS.ps1 tự điền các giá trị bên dưới.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAV (nếu máy chủ có) chặn PUT / DELETE: bỏ cho site này -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <!-- cài làm ứng dụng con dưới site ASP.NET Core khác: bỏ handler thừa kế từ site cha -->
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\ChamCongMayChu.exe" arguments="" hostingModel="outofprocess"
                  requestTimeout="00:05:00" startupTimeLimit="60" shutdownTimeLimit="10"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="CHAMCONG_DULIEU" value="D:\ChamCongData" />
          <environmentVariable name="CHAMCONG_SAOLUU" value="D:\ChamCongData\SaoLuu" />
          <environmentVariable name="CHAMCONG_CHI_HTTPS" value="0" />
          <environmentVariable name="CHAMCONG_HSTS" value="0" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- dữ liệu gửi lên tới 64 MB -->
          <requestLimits maxAllowedContentLength="67108864" />
          <verbs allowUnlisted="true" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
