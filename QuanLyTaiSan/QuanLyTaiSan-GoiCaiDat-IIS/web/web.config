<?xml version="1.0" encoding="utf-8"?>
<!--
  Site / ứng dụng IIS của phần mềm Quản lý tài sản (máy chủ dữ liệu cho máy tính và điện thoại).
  ASP.NET Core Module V2 (có sẵn trong ASP.NET Core Hosting Bundle) chạy QuanLyTaiSan.exe ở chế độ out-of-process
  và chuyển mọi yêu cầu tới nó. App pool: No Managed Code. Dữ liệu nằm ở thư mục QLTS_DULIEU (ngoài thư mục web).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAV (nếu máy chủ có) chặn PUT / DELETE: bỏ cho site này -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <!-- cài làm ứng dụng con dưới site ASP.NET Core khác (vd site Thất thoát nước): bỏ handler thừa kế từ site cha -->
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\QuanLyTaiSan.exe" arguments="" hostingModel="outofprocess"
                  requestTimeout="00:05:00" startupTimeLimit="60" shutdownTimeLimit="10"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="QLTS_DULIEU" value="C:\QuanLyTaiSanData" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- ảnh, file Excel gửi lên tới 40 MB -->
          <requestLimits maxAllowedContentLength="41943040" />
          <verbs allowUnlisted="true" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
