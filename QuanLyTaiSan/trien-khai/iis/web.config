<?xml version="1.0" encoding="utf-8"?>
<!--
  Quan ly tai san tren IIS (giong may chu HawaMap): IIS tu chay va giam sat QuanLyTaiSan.exe qua HttpPlatformHandler.
  Thu muc goc cua site = thu muc chuong trinh (QuanLyTaiSan.exe, web.config, logs\). Du lieu nam o thu muc rieng (QLTS_DULIEU).
  Can cai: HttpPlatformHandler 1.2, URL Rewrite 2.1 (cung 2 module ma HawaMap dung), .NET Framework 4.5+ (co san trong Windows Server).

  Script trien-khai\iis\cai-dat-iis.ps1 tu dien cac gia tri __...__ ben duoi. Sua tay thi thay:
    __THU_MUC__    thu muc chuong trinh, vd. C:\inetpub\QuanLyTaiSan
    __DU_LIEU__    thu muc du lieu (tai san, anh, lich su, tai khoan), vd. C:\QuanLyTaiSanData - tai khoan "IIS AppPool\QuanLyTaiSan" can quyen sua
-->
<configuration>
  <system.webServer>
    <!-- WebDAV (neu may chu co) chan PUT / DELETE: bo cho site nay -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <!-- moi yeu cau chuyen cho QuanLyTaiSan.exe: IIS khong tu phuc vu tep nao trong thu muc (file .exe, web.config khong bi tai ve) -->
      <add name="QuanLyTaiSan" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <!-- HttpPlatformHandler chon cong noi bo, dat bien HTTP_PLATFORM_PORT cho QuanLyTaiSan.exe va chuyen yeu cau toi do -->
    <httpPlatform processPath="__THU_MUC__\QuanLyTaiSan.exe" arguments=""
                  startupTimeLimit="60" startupRetryCount="3" requestTimeout="00:05:00"
                  stdoutLogEnabled="true" stdoutLogFile="__THU_MUC__\logs\maychu" processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="QLTS_DULIEU" value="__DU_LIEU__" />
      </environmentVariables>
    </httpPlatform>
    <rewrite>
      <rules>
        <!-- camera quet QR, GPS tren dien thoai chi chay qua HTTPS: script cai dat bat (enabled="true") khi site da co binding HTTPS cua ten mien -->
        <rule name="QuanLyTaiSan-HTTPS" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <add input="{HTTP_HOST}" pattern="^(localhost|127\.0\.0\.1)(:\d+)?$" negate="true" />
            <!-- de Let's Encrypt (win-acme) xac minh ten mien qua http khi xin / gia han chung chi -->
            <add input="{REQUEST_URI}" pattern="^/\.well-known/acme-challenge/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- ghi IP that cua nguoi dung cho QuanLyTaiSan.exe (khoa tam khi dang nhap sai nhieu lan, nhat ky) -->
        <rule name="QuanLyTaiSan-IP">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="None" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- anh, file Excel gui len toi 40 MB -->
        <requestLimits maxAllowedContentLength="41943040" />
        <verbs allowUnlisted="true" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
