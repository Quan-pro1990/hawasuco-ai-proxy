# Chép file này thành ".env" (cùng thư mục) rồi điền giá trị. File .env không bị đưa lên GitHub.

# Khóa YouTube Data API v3 (miễn phí) để tìm bài. Nhiều khóa thì cách nhau bằng dấu phẩy:
# hết lượt khóa đầu phần mềm tự chuyển sang khóa sau. Cũng có thể nhập khóa trong phần Cài đặt.
YOUTUBE_API_KEY=

# Mã quản lý (4-8 chữ số). Để trống = ai mở trang điều khiển cũng điều khiển được.
# Có mã: khách quét QR chỉ tìm và thêm bài; điều khiển, xóa, đổi thứ tự cần mã.
CONTROL_PIN=

# Cổng chạy phần mềm (mặc định 3000)
PORT=3000
