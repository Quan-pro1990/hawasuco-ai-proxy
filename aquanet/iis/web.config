<?xml version="1.0" encoding="utf-8"?>
<!--
  Site IIS của AquaNet GIS. ASP.NET Core Module V2 (có trong ASP.NET Core Hosting Bundle) chạy
  "python.exe run_iis.py" ở chế độ out-of-process và chuyển mọi yêu cầu tới nó.
  CaiDat-IIS.ps1 tự điền các đường dẫn tuyệt đối dưới đây khi cài. App pool: No Managed Code.
  Cấu hình bí mật (chuỗi kết nối CSDL, SECRET_KEY…) KHÔNG nằm ở đây mà ở AQUANET_DULIEU\aquanet.env.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAV (nếu máy chủ có) chặn PUT / DELETE: bỏ cho site này -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- requestTimeout > 5 phút: luồng số liệu SCADA thời gian thực giữ một kết nối tới 5 phút -->
      <aspNetCore processPath="C:\inetpub\AquaNet\venv\Scripts\python.exe"
                  arguments="&quot;C:\inetpub\AquaNet\run_iis.py&quot;"
                  hostingModel="outofprocess" requestTimeout="00:10:00" startupTimeLimit="120" shutdownTimeLimit="10"
                  stdoutLogEnabled="true" stdoutLogFile="C:\AquaNetData\NhatKy\stdout">
        <environmentVariables>
          <environmentVariable name="AQUANET_DULIEU" value="C:\AquaNetData" />
          <environmentVariable name="PYTHONUTF8" value="1" />
          <environmentVariable name="PYTHONUNBUFFERED" value="1" />
          <environmentVariable name="TEMP" value="C:\AquaNetData\tmp" />
          <environmentVariable name="TMP" value="C:\AquaNetData\tmp" />
        </environmentVariables>
      </aspNetCore>
      <!-- ứng dụng tự nén gzip; tắt nén của IIS để không giữ lại luồng thời gian thực -->
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
      <security>
        <requestFiltering>
          <!-- ảnh hiện trường, tệp GeoJSON nhập từ QGIS: tối đa 100 MB -->
          <requestLimits maxAllowedContentLength="104857600" />
          <verbs allowUnlisted="true" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
